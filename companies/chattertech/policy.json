    },
    "bulk_apollo_search": {
      "enabled": true,
      "threshold_results": 50,
      "reason": "Cost control and lead quality assurance",
      "approvers": ["CEO"]
    },
    "discounts": {
      "enabled": true,
      "threshold_percent": 20,
      "reason": "Revenue protection and pricing consistency",
      "approvers": ["CEO"]
    },
    "custom_integrations": {
      "enabled": true,

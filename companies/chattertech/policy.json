    "phone_outbound": {
      "enabled": true,
      "threshold_daily_calls": 50,
      "reason": "Cost control and TCPA compliance",
      "approvers": ["CEO"]
    }
  },
  
  "compliance_rules": {
    "tcpa_compliance": {
      "description": "Telephone Consumer Protection Act compliance for outbound calls",
      "rules": [
        "Do not call numbers on DNC registry",
        "Only call businesses, not consumers",
        "Maintain call recordings for 2 years",
        "Provide opt-out mechanism in all calls"
      ]
    },
    "can_spam_compliance": {
      "description": "CAN-SPAM Act compliance for outbound email",
      "rules": [
        "Include physical address in all emails",
        "Include clear unsubscribe link",
        "Honor unsubscribe within 10 business days",
        "Use accurate subject lines (no deception)"
      ]
    },
    "data_retention": {
      "call_recordings_days": 730,
      "transcripts_days": 730,
      "lead_data_days": 1095,
      "analytics_days": 365
    }
  },
  
  "brand_guidelines": {
    "tone": "Professional but approachable",
    "style": "Confident, not salesy, focused on ROI",
    "language": "Concrete numbers over vague promises",
    "personality": "Reliable helper, not pushy salesman",
    "forbidden_phrases": [
      "guaranteed results",
      "best in the world",
      "never miss a call again",
      "completely automated"
    ],
    "preferred_phrases": [
      "industry-leading answer rate",
      "customers recover 5-10x the cost",
      "catches 94%+ of calls",
      "AI-powered with human oversight"
    ]
  },
  
  "operational_policies": {
    "trial_policy": {
      "length_days": 7,
      "credit_card_required": false,
      "features_included": "all",
      "conversion_offer": "First month 50% off if converted within trial",

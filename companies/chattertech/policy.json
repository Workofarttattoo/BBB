    },
    "sla": {
      "uptime_guarantee": "99.5%",
      "response_time_hours": 4,
      "resolution_time_hours": 24
    }
  },
  
  "escalation_matrix": {
    "technical_issue": {
      "level_1": "AI Agent (auto-resolve common issues)",
      "level_2": "Human Support (escalate if unresolved in 1 hour)",

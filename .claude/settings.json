{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "mcpServers": {
        "figma": {
            "command": "npx",
            "args": ["-y", "@figma/mcp"],
            "env": {
                "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
            }
        }
    },
    "permissions": {
        "allow": [
            "mcp__figma__*"
        ]
    }
}

# Echo (Ollama) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ech0-fine-tuned-v2:latest
ECH0_LLM_PROVIDER=ollama
ECH0_LLM_ENDPOINT=
ECH0_LLM_API_KEY=
ECH0_LLM_TIMEOUT_SECONDS=180
ECHO_BASE_URL=
ECHO_PRIME_BASE_URL=

# Role Agent Models (Viktor-style)
ROLE_WORKER_MODEL=qwen3.5:4b
ROLE_JUDGE_MODEL=qwen3.5:4b
MIDDLE_MANAGER_MODEL=qwen3.5:9b
ROLE_CSUITE_MODEL=ech0-fine-tuned-v2:latest

# Twilio (SMS & Voice) - NOT USED, using ElevenLabs only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs (AI Voice) - REQUIRED for ChatterTech
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_AGENT_ID=  # Pre-configured Conversational AI agent ID

# Firebase (Knowledge Sync)
FIREBASE_CREDENTIALS_PATH=  # Path to service account JSON
FIREBASE_DATABASE_URL=  # e.g., https://your-project.firebaseio.com

# Redis/Celery (Task Queue) - REQUIRED for production
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Paperclip (Issue Tracking) - OPTIONAL
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_TOKEN=

# Email (IMAP) - CONFIGURED for ChatterTech
EMAIL_IMAP_SERVER=mail.privatemail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=inventor@aios.is
EMAIL_PASSWORD=F00lpr00f596!
SENDGRID_API_KEY=  # Not used, IMAP only
SENDGRID_FROM_EMAIL=inventor@aios.is

# Buffer (Social Media)
BUFFER_ACCESS_TOKEN=

# OpenAI / Anthropic (Optional Cloud AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./business_builder.db

# BBB Settings
MIDDLE_MANAGER_ENABLED=true
VIKTOR_MODE_ENABLED=true
DEFAULT_COMPANY=chattertech

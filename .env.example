# ══════════════════════════════════════════════════════════
#  BBB Environment Configuration
#  Copy to .env and fill in your values.
# ══════════════════════════════════════════════════════════

# ── Intelligence / Paperclip Adapter ──────────────────────
# Provider chain: paperclip auto-routes Hermes → Claude → Ollama → fallback
LLM_PROVIDER=paperclip

# Hermes VPS — always-on private brain on your VPS
# Setup: ssh vps && ollama pull hermes3 && OLLAMA_HOST=0.0.0.0 ollama serve
HERMES_VPS_URL=http://YOUR_VPS_IP:11434
HERMES_MODEL=hermes3
HERMES_API_KEY=
HERMES_TIMEOUT=60

# Ollama (local fallback, same machine as BBB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3

# ECH0 / Echo Prime settings
ECH0_LLM_PROVIDER=paperclip
ECH0_LLM_ENDPOINT=
ECH0_LLM_API_KEY=
ECH0_LLM_TIMEOUT_SECONDS=180
ECHO_BASE_URL=
ECHO_PRIME_BASE_URL=

# Anthropic (Claude / paperclip cloud fallback)
ANTHROPIC_API_KEY=

# OpenAI (optional additional fallback)
OPENAI_API_KEY=

# ── Voice — Bland AI (replaces ElevenLabs) ────────────────
# Bland handles BOTH outbound calls AND text-to-speech
BLAND_API_KEY=
BLAND_WEBHOOK_SECRET=
BLAND_BASE_URL=https://api.bland.ai
BLAND_VOICE_ID=                          # from GET /v1/voices
BLAND_FROM_NUMBER=
BLAND_DEFAULT_LANGUAGE=en-US
BLAND_MAX_DURATION_MINUTES=8
BLAND_WAIT_FOR_GREETING=true
BLAND_RECORD_CALLS=true
BBB_PERSONA_ID=

# ── Lead Generation ───────────────────────────────────────
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io

# ── Email ─────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@betterbusinessbuilder.com

# ── Payments ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Social Media ──────────────────────────────────────────
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_BEARER_TOKEN=
BUFFER_ACCESS_TOKEN=

# ── Team Notifications ────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_SALES=
SLACK_CHANNEL_MARKETING=
SLACK_CHANNEL_OPS=
SLACK_CHANNEL_EXEC=
SLACK_CHANNEL_SUPPORT=

# ── SMS ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Application ───────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./business_builder.db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Echo (Ollama) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ech0-fine-tuned-v2:latest

# Middle Manager (long-horizon local supervisor) + Judge (fast critic)
# Providers: ollama | lmstudio
MIDDLE_MANAGER_ENABLED=true
MIDDLE_MANAGER_PROVIDER=ollama
MIDDLE_MANAGER_BASE_URL=http://localhost:11434
MIDDLE_MANAGER_MODEL=qwen3.5:9b
MIDDLE_MANAGER_HEARTBEAT_MINUTES=30
MIDDLE_MANAGER_DEFAULT_BUSINESS=SaaS Micro-Tools Empire
MIDDLE_MANAGER_LOG_PATH=./logs/middle_manager.jsonl
JUDGE_PROVIDER=ollama
JUDGE_BASE_URL=http://localhost:11434
JUDGE_MODEL=ech0-fine-tuned-v2:latest
LMSTUDIO_BASE_URL=http://localhost:1234
MILESTONE_PARLIAMENT_THRESHOLD=0.85

# Per-role model tiers (flash workers / c-suite planners)
ROLE_WORKER_PROVIDER=ollama
ROLE_WORKER_BASE_URL=http://localhost:11434
ROLE_WORKER_MODEL=qwen3.5:4b
ROLE_CSUITE_PROVIDER=ollama
ROLE_CSUITE_BASE_URL=http://localhost:11434
ROLE_CSUITE_MODEL=ech0-fine-tuned-v2:latest
DEFAULT_COMPANY_SLUG=saas-micro-tools
AUTO_JUDGE_ENABLED=true
AUTO_JUDGE_MAX_REVISE=3
JUDGE_LOG_PATH=./logs/judge.jsonl
BBB_TASK_LOCK_DIR=./logs/task_locks
BBB_SANDBOX_ROOT=./workspace
# Optional: path to GGUF on external drive for ollama create / LM Studio load
# QWEN_GGUF_PATH=/Volumes/3NCRYPT3D_V4ULT/Qwen3.5-9B-ultra-uncensored-heretic-v2-Q8_0.gguf

ECH0_LLM_PROVIDER=ollama
ECH0_LLM_ENDPOINT=
ECH0_LLM_API_KEY=
ECH0_LLM_TIMEOUT_SECONDS=180
ECHO_BASE_URL=
ECHO_PRIME_BASE_URL=
PAPERCLIP_API_URL=http://127.0.0.1:3100
BBB_INTERNAL_API_TOKEN=

# Apollo (Headhunter / lead search — manual or gated agent path)
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io

# Twilio (SMS & Voice)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15555555555

# ElevenLabs (AI Voice)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@betterbusinessbuilder.com

# Buffer (Social Media)
BUFFER_ACCESS_TOKEN=your_buffer_token_here

# OpenAI / Anthropic (Optional Cloud AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Settings
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./business_builder.db
